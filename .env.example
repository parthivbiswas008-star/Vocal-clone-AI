# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# CARTESIA_API_KEY: Optional/Recommended for true 1:1 zero-shot neural voice cloning via Cartesia Sonic-3.
# Users can configure this via the Secrets panel in AI Studio or inside the app's API Keys / Settings screen.
CARTESIA_API_KEY=MY_CARTESIA_API_KEY
